{
  "name": "moekoemusic",
  "version": "1.7.1",
  "homepage": "https://music.moekoe.cn/",
  "main": "electron/main.js",
  "scripts": {
    "install-all": "echo this script was deprecated, and will be remove in future. && npm run install",
    "serve": "cross-env VITE_APP_ENV=web vite",
    "serve:client": "cross-env VITE_APP_ENV=client vite",
    "build": "cross-env VITE_APP_ENV=web vite build",
    "build:client": "cross-env VITE_APP_ENV=client vite build",
    "build:docker": "cross-env VITE_APP_ENV=web VITE_APP_API_URL=/api vite build",
    "preview": "vite preview",
    "electron:serve": "cross-env NODE_ENV=development electron .",
    "api": "kugoumusicapi --platform=lite --port=6521",
    "dev": "run-p api serve",
    "dev:client": "run-p serve:client electron:serve",
    "electron:build:win": "npm run electron:build -- --win --publish never",
    "electron:build:linux": "npm run electron:build -- --linux --publish never",
    "electron:build:linux-arm64": "npm run electron:build -- --linux --publish never",
    "electron:build:macos": "npm run electron:build -- --mac --x64 --arm64 --publish never",
    "electron:build:macos:universal": "npm run electron:build -- --mac --universal --publish never",
    "electron:build:macos:x64": "npm run electron:build -- --mac --x64 --publish never",
    "electron:build:macos:arm64": "npm run electron:build -- --mac --arm64 --publish never",
    "electron:build": "cross-env NODE_ENV=production electron-builder"
  },
  "engines": {
    "node": ">=20"
  },
  "desktopName": "cn.MoeKoe.Music",
  "build": {
    "publish": {
      "provider": "github",
      "owner": "MoeKoeMusic",
      "repo": "MoeKoeMusic"
    },
    "compression": "normal",
    "extraResources": [
      {
        "from": "build/icons/",
        "to": "icons/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraFiles": [
      {
        "from": "public/assets",
        "to": "assets"
      }
    ],
    "appId": "cn.MoeKoe.Music",
    "productName": "MoeKoe Music",
    "copyright": "© 2024 MoeKoe",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "icon": "build/icons/icon",
    "protocols": [
      {
        "name": "MoeKoe Music Protocol",
        "schemes": [
          "moekoe"
        ]
      }
    ],
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "artifactName": "MoeKoe_Music_Setup_v${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico",
      "installerHeaderIcon": "build/icons/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "MoeKoe Music",
      "include": "build/installer.nsh",
      "license": "build/license.txt",
      "language": "2052",
      "warningsAsErrors": true
    },
    "mac": {
      "x64ArchFiles": "*",
      "icon": "build/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "artifactName": "MoeKoe_Music_v${version}-${arch}.${ext}",
      "protocols": [
        {
          "name": "MoeKoe Music Protocol",
          "schemes": [
            "moekoe"
          ]
        }
      ]
    },
    "dmg": {
      "sign": false
    },
    "linux": {
      "icon": "build/icons/linux",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "artifactName": "MoeKoe_Music_v${version}-${arch}.${ext}"
    }
  },
  "type": "module",
  "private": true,
  "author": {
    "name": "MoeJue",
    "email": "MoeJue@qq.com"
  },
  "blog": "MoeJue.cn",
  "license": "GPL-2.0-only",
  "description": "MoeKoe Music",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/compiler-sfc": "^3.5.44",
    "cross-env": "^7.0.3",
    "electron": "^42.11.18",
    "electron-builder": "^26.18.0",
    "npm-run-all2": "^9.0.3",
    "sass-embedded": "^1.106.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vue-loader": "^17.4.2",
    "wait-on": "^8.0.5",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "axios": "^1.20.0",
    "electron-is-dev": "^3.0.1",
    "electron-log": "^5.4.4",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.8.9",
    "express": "^5.3.0",
    "kugoumusicapi": "github:MakcRe/KuGouMusicApi#5d6c9f7",
    "music-metadata": "^11.16.1",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "tree-kill": "^1.2.2",
    "vue": "^3.5.44",
    "vue-i18n": "^10.0.7",
    "vue-router": "^4.6.4",
    "vue3-virtual-scroller": "^0.2.3",
    "websocket-express": "^4.1.0",
    "ws": "^8.22.0"
  },
  "packageManager": "pnpm@12.15.0"
}
